    },
    "weather.humidity.impact.veryHigh" : {
      "extractionState" : "stale",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettet luft, ofte med tåke eller regn. Klær holder seg våte. Fare for nedkjøling."
          }
        }
      }
    },
    "weather.humidity.label" : {
      "extractionState" : "stale",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "luftfuktighet"
          }
        }
      }
    },
    "weather.humidity.tooltip" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relativ fuktighet måles i prosent. 100 % betyr at luften er mettet med vanndamp og ikke kan ta opp mer. Høy fuktighet (over 80 %) gjør at kroppen mister varme raskere, og klær som blir fuktige av svette isolerer dårlig. Tørr luft (under 30 %) gjør at du tørster fortere uten å merke det.\n\nHelse: I varmt vær svekker høy fuktighet kroppens avkjøling. Svette fordamper dårligere, og du kan kjenne klam tyngde, slapphet, hodepine og økt belastning på hjertet. Over 75–80 % fuktighet sammen med varme øker risikoen for overoppheting betydelig."
          }
        }
      }
    },
