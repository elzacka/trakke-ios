    "weather.temp.impact.cold" : {
      "extractionState" : "stale",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaldt. Ull innerst, vindtett ytterst. Ta ekstra klær i sekken."
          }
        }
      }
    },
    "weather.temp.impact.cool" : {
      "extractionState" : "stale",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjølig. Behagelig turvær med riktige klær. Ta med et ekstra lag til pauser."
          }
        }
      }
    },
    "weather.temp.impact.extremeCold" : {
      "extractionState" : "stale",
