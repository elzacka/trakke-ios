      }
    },
    "weather.temp.impact.mild" : {
      "extractionState" : "stale",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mildt. Lett bekledning holder. Fine forhold for tur og overnatting."
