    "weather.uv.snowNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snø reflekterer opptil 80 % av UV-strålingen. I fjellet med snø kan reell eksponering være vesentlig høyere."
          }
        }
      }
    },
    "weather.uv.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UV-indeks"
          }
        }
      }
    },
    "weather.uv.tooltip" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UV-indeksen viser hvor sterk UV-strålingen fra sola er ved bakkenivå. Jo høyere tall, desto raskere kan huden ta skade.\n\n0–2 Lav: Liten fare. Beskyttelse er normalt ikke nødvendig.\n3–5 Moderat: Bruk solkrem (SPF 30+), solbriller og noe på hodet. Søk skygge midt på dagen.\n6–7 Sterk: Klær, hatt, solbriller og rikelig med solkrem. Søk skygge mellom kl. 12 og 15.\n8–10 Svært sterk: Hudskade kan oppstå raskt. Dekk til, bredbremmet hatt og solkrem (SPF 30–50+).\n11+ Ekstrem: Maksimal beskyttelse. Hold deg i skyggen og unngå direkte sol midt på dagen.\n\nDSA anbefaler solbeskyttelse fra og med nivå 3. UV-strålingen øker med høyden (omtrent 10 % per 1000 meter), og refleksjon fra snø og vann kan forsterke eksponeringen ytterligere.\n\nKilde: Direktoratet for strålevern og atomsikkerhet (DSA)."
          }
        }
      }
    },
    "weather.uv.veryHigh" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svært sterk"
