          }
        }
      }
    },
    "weather.temperature.tooltip" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lufttemperaturen sier hvor varmt eller kaldt det er, men ikke hvor det kjennes. «Føles som» under graden viser opplevd temperatur og tar høyde for vind og luftfuktighet, og vises bare når den avviker fra målt temperatur.\n\nHelse: I kulde trekker blodårene seg sammen og blodtrykket stiger. Du som har hjerte-/karsykdom er mer utsatt. I varme er det dehydrering og overoppheting som blir risikoen. Drikk jevnlig, selv om du ikke er tørst. Meteorologisk institutt regner en hetebølge i Norge som fem dager eller mer med maksimum over 27 °C; eldre og kronisk syke er da særlig utsatt."
          }
        }
      }
    },
    "weather.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vær"
          }
        }
      }
    },
