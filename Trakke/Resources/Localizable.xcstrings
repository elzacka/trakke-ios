    "legend.attribution" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symboler: Beskårne utsnitt fra Kartverkets N50-tegnforklaring (CC BY 4.0). Zoomnivåer: Kartverkets spesifikasjon for skjermkartografi v2.2, kontrollert mot kartet."
          }
        }
      }
    },
    "legend.buildings.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skole og naust har egne symboler bare i trykte kart. På skjermkartet tegnes de som vanlige bygninger."
          }
        }
      }
    },
    "legend.coast.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varder, staker, bøyer og andre sjømerker hører til sjøkartene og tegnes ikke i dette kartet."
          }
        }
      }
    },
    "legend.footnote.fkb" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FKB (felles kartdatabase): Norges mest detaljerte kartgrunnlag, med enkeltbygninger, veier og stier slik de er registrert."
          }
        }
      }
    },
    "legend.footnote.n50" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N50: Kartverkets landsdekkende kartserie i målestokk 1:50 000, samme grunnlag som de trykte turkartene."
          }
        }
      }
    },
    "legend.fromZoom %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
